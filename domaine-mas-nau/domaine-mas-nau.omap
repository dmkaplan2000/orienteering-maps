<symbol type="2" id="128" code="513" name="Wall"><description>A significant wall of stone, concrete, wood or other materials.
Minimum height: 1 m.
Minimum length (isolated): 1.4 mm (footprint 21 m).</description><line_symbol color="4" line_width="420" minimum_length="4200" join_style="1" cap_style="0" start_offset="0" end_offset="0" segment_length="6000" end_length="3000" show_at_least_one_symbol="true" minimum_mid_symbol_count="0" minimum_mid_symbol_count_when_closed="0" dash_length="12000" break_length="3000" dashes_in_group="1" in_group_break_length="1500" mid_symbols_per_spot="1" mid_symbol_distance="0"><mid_symbol><symbol type="1" code="" name="Mid symbol"><point_symbol rotatable="true" inner_radius="600" inner_color="4" outer_width="0" outer_color="-1" elements="0"/></symbol></mid_symbol></line_symbol></symbol>
